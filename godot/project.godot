; Engine configuration file for Echos in the Scrap - Golden Slice v1
; Godot Engine 4.7 Mobile-First 3D Prototype

config_version=5

[application]
config/name="Echos in the Scrap - Golden Slice"
config/features=PackedStringArray("4.7", "Forward Plus")
run/main_scene="res://scenes/prototype/scrap_test_block.tscn"

[display]
window/size/viewport_width=960
window/size/viewport_height=540
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[input_devices]
pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[rendering]
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.05, 0.05, 0.07, 1)
